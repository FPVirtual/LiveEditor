# FPVirtual LiveEditor — build configuration
# Copy to `.env` and adjust. Parcel inlines these values at build time.

# LiaScript course player used for "view course" links
LIASCRIPT="https://liascript.github.io/course/"

# CORS proxy for external document links (leave empty if not needed)
PROXY=""

# FPVirtual: hide GitHub/GitLab/Gist integrations from the share dialog.
# Teachers save through the LMS button (liascript-lms), so no GitHub
# OAuth app is needed and the Git options would only confuse them.
LIAEDIT_HIDE_GIT=true

# Help link in the top bar (point to your own author guide when available)
LIAEDIT_HELP_URL="https://liascript.github.io/course/?https://raw.githubusercontent.com/liaScript/docs/master/README.md"

# Text-to-speech fallback engine key (optional)
# RESPONSIVEVOICE_KEY=""

# Collaboration (disabled by default in this deployment)
# SIGNALING_SERVER="wss://..."
# ICE_SERVERS='[{"urls":"stun:...."}]'
# WEBSOCKET_SERVER="wss://..."

# GitHub export (NOT used in this deployment — see LIAEDIT_HIDE_GIT)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
